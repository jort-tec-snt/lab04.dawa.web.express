<%- include("partials/head", { title }) %>
<body>
<%- include("partials/navigation", { active: "admin" }) %>

<main>
    <div class="app-container">
        <header class="page-heading">
            <div>
                <span class="eyebrow">Centro de control</span>
                <h1>Administración</h1>
                <p>Seguimiento de consultas recibidas desde el canal de contacto.</p>
            </div>
            <a href="/contact" class="btn waves-effect waves-light">
                <span class="material-symbols-outlined" aria-hidden="true">add</span>
                Nuevo mensaje
            </a>
        </header>

        <div class="metric-grid">
            <div class="metric-card"><span>Mensajes totales</span><span class="metric-value"><%= messages.length %></span></div>
            <div class="metric-card"><span>Estado del canal</span><span class="status-tag status-disponible">Activo</span></div>
            <div class="metric-card"><span>Almacenamiento</span><span class="metric-value">RAM</span></div>
        </div>

        <section class="catalog-panel">
            <div class="catalog-toolbar">
                <h2>Bandeja de mensajes</h2>
                <span class="protocol-tag"><%= messages.length %> recibidos</span>
            </div>

            <% if (messages.length === 0) { %>
                <div class="empty-state">
                    <span class="empty-icon"><span class="material-symbols-outlined">inbox</span></span>
                    <h3>No hay mensajes</h3>
                    <p>Las nuevas consultas del formulario de contacto aparecerán en esta bandeja.</p>
                </div>
            <% } else { %>
                <div class="message-list">
                    <% messages.forEach(message => { %>
                        <article class="message-item">
                            <div class="message-meta">
                                <strong><%= message.nombre %></strong>
                                <a href="mailto:<%= message.email %>"><%= message.email %></a>
                            </div>
                            <p><%= message.mensaje %></p>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </div>
</main>

<%- include("partials/footer") %>
</body>
</html>
