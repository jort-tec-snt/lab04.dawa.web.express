<%- include("partials/head", { title }) %>
<body>
<%- include("partials/navigation", { active: "contact" }) %>

<main>
    <div class="app-container">
        <header class="page-heading">
            <div>
                <span class="eyebrow">Canal de contacto</span>
                <h1>Conversemos</h1>
                <p>Envía una consulta relacionada con el catálogo, sus dispositivos o la integración de equipos IoT.</p>
            </div>
        </header>

        <div class="contact-grid">
            <section class="content-panel">
                <div class="panel-header">
                    <span class="panel-icon"><span class="material-symbols-outlined">send</span></span>
                    <div><h2>Nuevo mensaje</h2><p>Completa tus datos de contacto</p></div>
                </div>
                <form action="/contact" method="POST" class="panel-content">
                    <div class="input-field">
                        <span class="material-symbols-outlined prefix">person</span>
                        <input id="nombre" name="nombre" type="text" maxlength="80" required>
                        <label for="nombre">Nombre</label>
                    </div>
                    <div class="input-field">
                        <span class="material-symbols-outlined prefix">alternate_email</span>
                        <input id="email" name="email" type="email" maxlength="120" required>
                        <label for="email">Correo electrónico</label>
                    </div>
                    <div class="input-field">
                        <span class="material-symbols-outlined prefix">chat</span>
                        <textarea id="mensaje" name="mensaje" class="materialize-textarea" maxlength="800" required></textarea>
                        <label for="mensaje">Mensaje</label>
                    </div>
                    <div class="form-actions">
                        <button class="btn waves-effect waves-light" type="submit">
                            <span class="material-symbols-outlined" aria-hidden="true">send</span>
                            Enviar mensaje
                        </button>
                    </div>
                </form>
            </section>

            <aside class="info-panel">
                <div class="panel-header"><h2>Temas de consulta</h2></div>
                <div class="panel-content">
                    <ul class="info-list">
                        <li><span class="material-symbols-outlined">inventory_2</span><div><strong>Catálogo</strong><span>Equipos y disponibilidad</span></div></li>
                        <li><span class="material-symbols-outlined">wifi_tethering</span><div><strong>Conectividad</strong><span>Protocolos IoT</span></div></li>
                        <li><span class="material-symbols-outlined">integration_instructions</span><div><strong>Integración</strong><span>Datos técnicos</span></div></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</main>

<%- include("partials/footer") %>
</body>
</html>
