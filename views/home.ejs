<%- include("partials/head", { title }) %>
<body>
<%- include("partials/navigation", { active: "home" }) %>

<main class="home-main">
    <section class="home-hero">
        <div class="app-container hero-grid">
            <div>
                <span class="eyebrow">Ecosistema conectado</span>
                <h1>DAWA <span>IoT</span></h1>
                <p class="hero-copy">
                    Inventario central para sensores, actuadores y gateways. Organiza cada dispositivo por fabricante, protocolo, disponibilidad y precio.
                </p>
                <div class="hero-actions">
                    <a href="/devices" class="btn-large waves-effect waves-light">
                        <span class="material-symbols-outlined" aria-hidden="true">devices</span>
                        Explorar catálogo
                    </a>
                    <a href="/devices#register" class="btn-large btn-secondary waves-effect">
                        <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                        Registrar dispositivo
                    </a>
                </div>
            </div>

            <div class="network-panel" aria-label="Esquema de una red de dispositivos IoT">
                <div class="network-label"><span>Red IoT</span><span>Topología activa</span></div>
                <div class="network-node node-sensor" title="Sensor"><span class="material-symbols-outlined">sensors</span></div>
                <div class="network-node node-home" title="Dispositivo inteligente"><span class="material-symbols-outlined">home_iot_device</span></div>
                <div class="network-node node-router" title="Gateway"><span class="material-symbols-outlined">router</span></div>
                <div class="network-node node-meter" title="Medidor"><span class="material-symbols-outlined">speed</span></div>
                <div class="network-core"><span class="material-symbols-outlined">hub</span></div>
                <div class="network-status"><span class="status-light"></span> Sistema operativo</div>
            </div>
        </div>
    </section>

    <section class="app-container home-dashboard">
        <div class="section-heading">
            <h2>Familias de dispositivos</h2>
            <a href="/devices" class="text-link">Ver inventario <span class="material-symbols-outlined">arrow_forward</span></a>
        </div>

        <div class="category-grid">
            <a href="/devices" class="category-card">
                <span class="category-icon"><span class="material-symbols-outlined">sensors</span></span>
                <h3>Sensores</h3>
                <p>Temperatura, humedad, movimiento y calidad ambiental.</p>
            </a>
            <a href="/devices" class="category-card">
                <span class="category-icon"><span class="material-symbols-outlined">settings_remote</span></span>
                <h3>Actuadores</h3>
                <p>Relés, controladores, cerraduras y automatización remota.</p>
            </a>
            <a href="/devices" class="category-card">
                <span class="category-icon"><span class="material-symbols-outlined">router</span></span>
                <h3>Gateways</h3>
                <p>Conectividad Wi-Fi, Zigbee, Bluetooth, LoRaWAN y MQTT.</p>
            </a>
        </div>
    </section>
</main>

<%- include("partials/footer") %>
</body>
</html>
